# Which LLM to use: "anthropic", "openai", or "xai" (Grok)
LLM_PROVIDER=xai
# Model name exactly as shown in your provider's console (e.g. a Grok model for xai)
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Tiger Cloud connection string (optional — leave blank to skip the database)
DATABASE_URL=

# ---- Hosted/public site only (Streamlit Cloud secrets). Leave unset when running locally. ----
# TREX_PUBLIC=true            # turns on the limits below and hides the server-file CSV loader
# PUBLIC_MAX_PAPERS=2         # papers per extraction
# PUBLIC_MAX_PAGES=40         # pages per paper
# PUBLIC_MAX_MB=10            # size per paper
# PUBLIC_MAX_CALLS=6          # AI requests per paper (keeps the most table-heavy parts)
# PUBLIC_RUNS_PER_SESSION=3   # live extractions per visitor session
# PUBLIC_DAILY_RUNS=40        # live extractions per day, whole site (needs DATABASE_URL)
# DEMO_FIELDS=Model, Benchmark, Score   # which saved runs the "Try the demo" button loads
# TREX_UNLOCK=pick-a-secret-code         # typing this in the sidebar removes the limits for that session
